{
  "name": "@walos/os",
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "UI-independent browser WASI runtime for walos",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build --config vite.jco.config.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.12"
  }
}
