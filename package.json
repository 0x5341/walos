{
  "name": "walos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:apps": "node scripts/build-apps.mjs",
    "check": "tsc --noEmit",
    "build": "npm run build:apps && npm run check && vite build",
    "test": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "check:wit": "jco types wit -o work/wit-generated",
    "format": "prettier --write src tests scripts *.ts *.json index.html",
    "test:production": "WALOS_TEST_BUILD=1 playwright test"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "1.15.1",
    "@playwright/test": "1.56.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
